{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-escape://art-pack-manifest/2.0.0",
  "title": "TRACE//ESCAPE Art Pack Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "status", "artMode", "nativeResolution", "browserResolution", "scalingMode", "palette", "scenes", "characters", "props", "inventory", "cursor"],
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["src", "width", "height"], "properties": { "src": { "type": "string", "pattern": "^/art-packs/[a-z0-9-]+/[A-Za-z0-9][A-Za-z0-9._/-]*$", "not": { "pattern": "(?:^|/)\\.{1,2}(?:/|$)" } }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "animation": { "type": "object", "additionalProperties": false, "required": ["frames", "frameWidth", "frameHeight", "fps", "loop"], "properties": { "frames": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/asset" } }, "frameWidth": { "type": "number", "exclusiveMinimum": 0 }, "frameHeight": { "type": "number", "exclusiveMinimum": 0 }, "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 }, "loop": { "type": "boolean" }, "mirrorHorizontal": { "type": "boolean" } } },
    "character": { "type": "object", "additionalProperties": false, "required": ["anchor", "scale", "mirrorHorizontal", "animations"], "properties": { "anchor": { "$ref": "#/$defs/point" }, "scale": { "type": "number", "minimum": 0.5, "maximum": 4 }, "mirrorHorizontal": { "type": "boolean" }, "animations": { "type": "object", "minProperties": 4, "additionalProperties": false, "properties": { "idle": { "$ref": "#/$defs/animation" }, "walkEast": { "$ref": "#/$defs/animation" }, "talkClosed": { "$ref": "#/$defs/animation" }, "talkOpen": { "$ref": "#/$defs/animation" }, "inspect": { "$ref": "#/$defs/animation" }, "useGive": { "$ref": "#/$defs/animation" }, "stamp": { "$ref": "#/$defs/animation" } } } } },
    "layer": { "type": "object", "additionalProperties": false, "required": ["id", "asset", "depth"], "properties": { "id": { "type": "string" }, "asset": { "$ref": "#/$defs/asset" }, "depth": { "type": "number", "exclusiveMinimum": 0 } } },
    "scene": { "type": "object", "additionalProperties": false, "required": ["background", "midgroundLayers", "foregroundLayers", "walkRegionId", "hotspotGeometryId", "depthBands", "propPlacements", "characterAnchors"], "properties": { "background": { "$ref": "#/$defs/asset" }, "midgroundLayers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }, "foregroundLayers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }, "walkRegionId": { "type": "string" }, "hotspotGeometryId": { "type": "string" }, "depthBands": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "minY", "maxY", "zIndex"], "properties": { "id": { "type": "string", "minLength": 1 }, "minY": { "type": "number", "minimum": 0, "maximum": 360 }, "maxY": { "type": "number", "minimum": 0, "maximum": 360 }, "zIndex": { "type": "integer", "minimum": 1, "maximum": 20 } } } }, "propPlacements": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["propId", "x", "y", "depthBand"], "properties": { "propId": { "type": "string" }, "x": { "type": "number", "minimum": 0, "maximum": 960 }, "y": { "type": "number", "minimum": 0, "maximum": 360 }, "depthBand": { "type": "string" } } } }, "characterAnchors": { "type": "object", "additionalProperties": false, "required": ["rookStart", "mrIndex"], "properties": { "rookStart": { "$ref": "#/$defs/point" }, "mrIndex": { "$ref": "#/$defs/point" } } } } },
    "prop": { "type": "object", "additionalProperties": false, "required": ["default", "states"], "properties": { "default": { "$ref": "#/$defs/asset" }, "states": { "type": "object", "additionalProperties": { "$ref": "#/$defs/asset" } } } }
  },
  "properties": {
    "schemaVersion": { "const": "2.0.0" }, "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "status": { "enum": ["PROVISIONAL_PLACEHOLDER", "LEAD_SELECTED"] }, "artMode": { "enum": ["LOW_RES_ILLUSTRATED", "PIXEL_INSPIRED", "HIGH_RES_ILLUSTRATED_DOWNSAMPLED"] },
    "nativeResolution": { "type": "object", "additionalProperties": false, "required": ["width", "height", "sceneHeight", "interfaceHeight"], "properties": { "width": { "const": 480 }, "height": { "const": 270 }, "sceneHeight": { "const": 180 }, "interfaceHeight": { "const": 90 } } },
    "browserResolution": { "type": "object", "additionalProperties": false, "required": ["width", "height", "sceneHeight", "interfaceHeight"], "properties": { "width": { "const": 960 }, "height": { "const": 540 }, "sceneHeight": { "const": 360 }, "interfaceHeight": { "const": 180 } } },
    "scalingMode": { "const": "NEAREST_NEIGHBOR" }, "palette": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "scenes": { "type": "object", "additionalProperties": false, "required": ["records-office", "blank-shell"], "properties": { "records-office": { "$ref": "#/$defs/scene" }, "blank-shell": { "$ref": "#/$defs/scene" } } },
    "characters": { "type": "object", "additionalProperties": false, "required": ["rook", "mrIndex"], "properties": { "rook": { "$ref": "#/$defs/character" }, "mrIndex": { "$ref": "#/$defs/character" } } },
    "props": { "type": "object", "additionalProperties": false, "required": ["requestDispenser", "penStand", "pneumaticTube", "dispatchPlunger", "recordCanister", "nansenTerminal"], "properties": { "requestDispenser": { "$ref": "#/$defs/prop" }, "penStand": { "$ref": "#/$defs/prop" }, "pneumaticTube": { "$ref": "#/$defs/prop" }, "dispatchPlunger": { "$ref": "#/$defs/prop" }, "recordCanister": { "$ref": "#/$defs/prop" }, "nansenTerminal": { "$ref": "#/$defs/prop" } } },
    "inventory": { "type": "object", "additionalProperties": false, "required": ["blank-request", "completed-request", "stamped-request", "first-breach-strip"], "properties": { "blank-request": { "$ref": "#/$defs/asset" }, "completed-request": { "$ref": "#/$defs/asset" }, "stamped-request": { "$ref": "#/$defs/asset" }, "first-breach-strip": { "$ref": "#/$defs/asset" } } },
    "cursor": { "type": "object", "additionalProperties": false, "required": ["crosshair"], "properties": { "crosshair": { "$ref": "#/$defs/asset" } } }
  }
}
