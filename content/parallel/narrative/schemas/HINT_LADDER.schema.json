            "required": [
              "METHOD_HINT",
              "CASE_HINT",
              "DIRECT_HINT"
            ],
            "properties": {
              "METHOD_HINT": {
                "type": "string",
                "pattern": "^lane_a\\.[a-z0-9_.-]+$"
              },
              "CASE_HINT": {
                "type": "string",
                "pattern": "^lane_a\\.[a-z0-9_.-]+$"
              },
              "DIRECT_HINT": {
                "type": "string",
                "pattern": "^lane_a\\.[a-z0-9_.-]+$"
              }
