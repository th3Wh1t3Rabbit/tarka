{
  "name": "trace-escape",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "scripts": {
    "g6p:s2:generate": "node --require ./scripts/nq5-r2/hold.cjs scripts/nq5-s2/generate.mjs",
    "g6p:s2:verify": "node --require ./scripts/nq5-r2/hold.cjs scripts/nq5-s2/verify.mjs",
    "g6p:s2:package": "node --require ./scripts/nq5-r2/hold.cjs scripts/nq5-s2/package.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "release:verify": "npm run build && npm run browser-boundary:verify && node scripts/verify-release-portability.mjs && npm run docs:verify",
    "script:build": "rolldown scripts/docs/BUILD_SCRIPT_EXPLORER.ts --platform=node --format=esm --file=.docs-build/BUILD_SCRIPT_EXPLORER.mjs && node .docs-build/BUILD_SCRIPT_EXPLORER.mjs",
    "docs:build": "npm run script:build && python3 scripts/docs/BUILD_DOCUMENTATION.py",
    "docs:verify": "node scripts/verify-documentation-public.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "node scripts/s15-r1/run-owned-tests.mjs unit",
    "test:historical": "node scripts/s15-r1/run-owned-tests.mjs historical-unit",
    "test:historical-v1.1": "node scripts/nq5-s7-r3/validate-historical-v1-1.mjs",
    "test:all-contexts": "npm test && npm run test:historical-v1.1",
    "test:watch": "vitest",
    "review:principal": "node scripts/nq5-s7-r3/review-principal-r1.mjs && node scripts/nq5-s7-r3/build-renderer.mjs",
    "s7:r3:generate": "node scripts/nq5-s7-r3/generate.mjs && npm run review:principal",
    "test:e2e": "node scripts/s15-r1/run-owned-tests.mjs e2e",
    "test:e2e:historical": "node scripts/s15-r1/run-owned-tests.mjs historical-e2e",
    "g6p:a2u:verify": "node --require ./scripts/nq5-r2/hold.cjs scripts/package-nq5-r3-r1-checkpoint.mjs --verify-only",
    "g6p:a2u:package": "node --require ./scripts/nq5-r2/hold.cjs scripts/package-nq5-r3-r1-checkpoint.mjs",
    "artifacts:capture": "playwright test tests/e2e/g6p-capture.spec.ts",
    "acquisition:compile": "tsc -p tsconfig.acquisition.json --pretty false",
    "acquisition:preflight": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/preflight.js",
    "acquisition:status": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/status.js",
    "acquisition:dry-run": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/dry-run.js",
    "acquisition:verify-store": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/verify-store.js",
    "acquisition:prove-no-network": "npm run acquisition:compile --silent && node scripts/run-network-guarded-dry-run.mjs",
    "g4a:precall-report": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g4a-precall.js",
    "g4a:audition": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g4a-audition.js",
    "g4a:reconstruct": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g4a-reconstruct.js",
    "g4a:verify": "node scripts/run-g4a-final-verification.mjs",
    "g4a:package": "node scripts/package-g4a-delivery.mjs",
    "g5:closure-preflight": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g5-euler-closure.js preflight",
    "g5:closure": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g5-euler-closure.js run",
    "g5:closure-recover": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g5-euler-closure.js recover",
    "g5:bybit-reserve-preflight": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g5-bybit-reserve.js preflight",
    "g5:bybit-reserve": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g5-bybit-reserve.js run",
    "g5:pack": "node scripts/g5-pack.mjs generate",
    "g5:pack:verify": "node scripts/g5-pack.mjs verify",
    "g5:boundary:verify": "node scripts/verify-g5-boundaries.mjs",
    "g5:verify": "node scripts/run-g5-final-verification.mjs",
    "g5:package": "node scripts/package-g5-delivery.mjs",
    "g6:coverage": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/g6-euler-coverage.js run",
    "g6:presentation-health": "node scripts/g6-presentation-health.mjs",
    "g6:preview:sync": "node scripts/sync-g6-principal-preview.mjs",
    "g6:pack": "node scripts/g5-pack.mjs generate",
    "g6:pack:verify": "node scripts/g5-pack.mjs verify",
    "g6:boundary:verify": "node scripts/verify-g6-boundaries.mjs",
    "g6:verify": "node scripts/run-g6-final-verification.mjs",
    "g6:package": "node scripts/package-g6-delivery.mjs",
    "g6p:boundary:verify": "node scripts/verify-g6p-boundaries.mjs",
    "g6p:preview:sync": "node scripts/sync-g6p-preview.mjs",
    "g6p:presentation-health": "node scripts/g6p-presentation-health.mjs",
    "g6p:verify": "node scripts/run-g6p-final-verification.mjs",
    "g6p:package": "node scripts/package-g6p-delivery.mjs",
    "g6p:a1:boundary:verify": "node scripts/verify-g6p-a1-boundaries.mjs",
    "g6p:a1:verify": "node scripts/run-g6p-a1-final-verification.mjs",
    "g6p:a1:package": "node scripts/package-g6p-a1-delivery.mjs",
    "g6p:a1:r1:verify": "node scripts/run-g6p-a1-final-verification.mjs",
    "g6p:a1:r1:package": "node scripts/package-g6p-a1-delivery.mjs",
    "g6p:a1:r2:verify": "node scripts/run-g6p-a1-final-verification.mjs",
    "g6p:a1:r2:package": "node scripts/package-g6p-a1-delivery.mjs",
    "g6p:a2p:verify": "node scripts/run-g6p-a2p-verification.mjs",
    "g6p:a2p:package": "node scripts/package-g6p-a2p-delivery.mjs",
    "export:lint": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/export-lint.js",
    "case:score": "npm run acquisition:compile --silent && node .acquisition-build/scripts/acquisition/case-score.js",
    "test:acquisition": "vitest run tests/acquisition",
    "test:g2:focused": "playwright test tests/e2e/cold-open.spec.ts --grep \"reduced-motion keyboard journey\"",
    "browser-boundary:verify": "node scripts/verify-browser-boundary.mjs",
    "secret:scan": "node scripts/scan-prohibitions.mjs",
    "secret:scan-history": "node scripts/verify-git-secret-history.mjs",
    "verify": "npm run check && npm run test && npm run test:e2e && npm run build && npm run artifacts:capture && npm run secret:scan",
    "delivery:verify": "node scripts/run-delivery-verification.mjs",
    "project:clock": "node scripts/project-clock.mjs",
    "project:status": "node scripts/project-status.mjs",
    "s2-r1:generate": "node scripts/nq5-s2-r1/generate.mjs",
    "s2-r1:verify": "node scripts/nq5-s2-r1/verify.mjs",
    "s2-r1:package": "node scripts/nq5-s2-r1/package.mjs"
  },
  "dependencies": {
    "js-yaml": "5.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
